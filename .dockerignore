# Nothing secret and nothing heavy should reach the build context.
.env
.env.*
*.pem
*.key

.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# the image serves the app; it does not need the tests, the docs or the research artifacts
tests/
docs/
*.db
*.sqlite3
*.db-journal
